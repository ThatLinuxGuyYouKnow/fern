# fern Caddyfile — EC2 production (single instance + Route53 wildcard)
#
# TLS model: ONE wildcard cert (*.DOMAIN) covers ALL tenants (<slug>.DOMAIN).
# Do NOT mint a cert per tenant — Caddy issues 2 certs total (apex + wildcard)
# and auto-renews them. Per-tenant certs are only needed for custom seller
# domains (shop.seller.com); that's the commented on-demand block at the bottom.
#
# Required env (see docker-compose.prod.yml / deploy/ec2-user-data.sh):
#   DOMAIN            e.g. fernshop.com  (Route53 hosted zone + A records below)
#   ACME_EMAIL        e.g. admin@fernshop.com (Let's Encrypt notices)
# Route53 DNS-01 needs AWS creds OR an EC2 instance role with
#   route53:ChangeResourceRecordSets on the hosted zone (preferred — no keys).
#
# DNS setup (Route53, one time):
#   A  fernshop.com      → <EC2 elastic IP>
#   A  *.fernshop.com    → <EC2 elastic IP>   (all tenants ride this record)
# Security group: allow tcp:80,443 from 0.0.0.0/0.
#
# Testing without a real domain: keep the old DuckDNS flow
# (deploy/gce-startup.sh + a duckdns-plugin Caddy build).

{
	email {$ACME_EMAIL}
	# Global options: keep defaults; DNS-01 is set per-site below.
}

# Apex / platform app: create wizard, admin, /s/<slug> fallback
{$DOMAIN} {
	encode gzip
	reverse_proxy app:3000
}

# All tenants: <slug>.DOMAIN → middleware.ts parses Host → rewrite /s/<slug>
*.{$DOMAIN} {
	tls {
		dns route53
	}
	encode gzip
	reverse_proxy app:3000
}

# --- Custom seller domains (OPTIONAL, off by default) ---
# If you later let sellers point their own domain at you (shop.seller.com → IP),
# enable on-demand TLS instead of a wildcard:
#
# {
# 	email {$ACME_EMAIL}
# 	on_demand_tls {
# 		ask http://app:3000/api/tls-allowlist
# 		# interval 2m
# 		# burst 5
# 	}
# }
# :443 {
# 	tls {
# 		on_demand
# 	}
# 	encode gzip
# 	reverse_proxy app:3000
# }
# ...and implement GET /api/tls-allowlist?domain=shop.seller.com → 200 only for
# domains present in your stores table (custom_domain column — doesn't exist yet).
