# PayPal sandbox (business/merchant account) — DUMMY_* enables simulated checkout
PAYPAL_CLIENT_ID=DUMMY_CLIENT_ID
PAYPAL_CLIENT_SECRET=DUMMY_CLIENT_SECRET
PAYPAL_MODE=sandbox
NEXT_PUBLIC_PAYPAL_CLIENT_ID=DUMMY_CLIENT_ID

# Apex domain for tenant resolution (no protocol). Local dev: localhost:3000
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000

# DeepSeek API key (server-only) — enables real AI theme generation.
# Get one at https://platform.deepseek.com/api_keys . Never prefix with NEXT_PUBLIC_.
# Optional: DEEPSEEK_MODEL=deepseek-chat (default), DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=

