# Copy to deploy/aws.env (gitignored) and fill in.
#   set -a; source deploy/aws.env; set +a
#   bash deploy/aws-bootstrap.sh

AWS_REGION=eu-north-1
VPC_ID=vpc-0bf4f60cc1b1183fc
SUBNET_ID=subnet-06966d7af0058dd88   # public subnet (0.0.0.0/0 -> igw-*)
KEY_NAME=                              # optional — Session Manager works without SSH keys
AMI_ID=ami-084df9e6ad4622caf           # Ubuntu 24.04, eu-north-1 (match AWS_REGION)
INSTANCE_TYPE=t3.micro

# --- DNS / TLS provider ---
# route53: custom domain — also set HOSTED_ZONE_ID
# duckdns: free <name>.duckdns.org — also set DUCKDNS_TOKEN
DNS_PROVIDER=duckdns
HOSTED_ZONE_ID=ZREPLACE_ME             # route53 only

DOMAIN=fernshop.duckdns.org            # duckdns: <name>.duckdns.org
ACME_EMAIL=admin@fernshop.com
DUCKDNS_TOKEN=                         # from duckdns.org account page
# DuckDNS dashboard: create just "<name>" (e.g. "paypal-fern"). Do NOT try to
# add "*.<name>" — DuckDNS rejects "*"; tenant subdomains inherit the A record.

REPO_URL=https://github.com/YOU/fern.git

# app env (baked into user-data at boot)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
NEXT_PUBLIC_ROOT_DOMAIN=               # defaults to DOMAIN
DEEPSEEK_API_KEY=
